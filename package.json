{
  "name": "linguacast",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "gen": "pnpm -F @linguacast/contract gen",
    "build": "pnpm gen && pnpm -F @linguacast/server build",
    "typecheck": "pnpm gen && pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}
