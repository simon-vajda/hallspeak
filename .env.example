# Copy this file to .env, fill in MEDIA_ANNOUNCED_IP, and run `docker compose up -d`.
# Everything else has a working default. See docs/hosting.md.

# The image to run. Upgrading is: edit this line, then `docker compose pull` and
# `docker compose up -d`. Use `latest` instead to take every release as it lands.
LINGUACAST_VERSION=0.2.0

# REQUIRED. Your public hostname — usually the same one your reverse proxy serves, e.g.
# linguacast.example.com — or your public IP address if you have no hostname. It goes
# straight into the ICE candidates guests connect back on, so a wrong value produces a
# deployment where every screen loads and no audio ever arrives, with no error anywhere.
MEDIA_ANNOUNCED_IP=

# LinguaCast resolves the hostname above to an IP address and re-announces it whenever it
# moves, so a home connection with a changing public IP needs no attention. Set this to
# true to put the hostname itself into the ICE candidates instead. Firefox refuses a
# candidate that names a hostname rather than an address and will play no audio at all,
# while Chrome resolves it and works — so only turn this on if you know why you need it.
MEDIA_ANNOUNCE_HOSTNAME=false

# The address your reverse proxy reaches the container from. Empty means no
# X-Forwarded-For header is ever believed, which behind a proxy collapses every visitor
# into one sign-in throttle bucket. It is usually not the proxy's LAN address —
# docs/hosting.md gives the value for each proxy placement.
TRUSTED_PROXY_IPS=

# How many CPU cores LinguaCast may use, which is how many events can run at once. One
# event runs on one core start to finish, so this buys parallelism between events and
# crash protection, never a bigger audience for a single one. Capped by the host's core
# count. Each core in use needs one RTC port, so raising this means publishing and
# forwarding the matching extra ports.
MEDIA_MAX_WORKERS=4

# The uid/gid the server runs as, and the owner the container gives the data directory.
# Set these to your own if you want to read the database from the host.
PUID=1000
PGID=1000

# Helps a guest behind a restrictive NAT discover the address to advertise. Set it empty
# to use none — this server is a third party learning that a guest connected here.
MEDIA_STUN_URL=stun:stun.l.google.com:19302

# A TURN relay carries audio for guests whose network blocks both UDP and TCP to the RTC
# ports. Both are needed for either to apply, and standing one up is its own deployment.
#MEDIA_TURN_URL=
#MEDIA_TURN_SECRET=
