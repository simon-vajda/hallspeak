# Copy this file to .env, fill in PUBLIC_ADDRESS, and run `docker compose up -d`.
# Every commented-out line below shows the default — uncomment one only to change it.
# See docs/hosting.md.

# REQUIRED. Where guests reach this server: your public hostname, usually the same one
# your reverse proxy serves, e.g. linguacast.example.com — or your public IP address if
# you have no hostname.
#
# Audio does not go through your reverse proxy. It connects here directly, so this must be
# reachable from the internet on the RTC ports even though your proxy already works. A
# wrong value produces a deployment where every screen loads and no audio ever arrives,
# with no error anywhere.
PUBLIC_ADDRESS=

# The address your reverse proxy reaches the container from. Empty means no
# X-Forwarded-For header is ever believed, which behind a proxy collapses every visitor
# into one sign-in throttle bucket. It is usually not the proxy's LAN address —
# docs/hosting.md gives the value for each proxy placement.
TRUSTED_PROXY_IPS=

# The image to run. Upgrading is: edit this line, then `docker compose pull` and
# `docker compose up -d`. Use `latest` instead to take every release as it lands.
LINGUACAST_VERSION=0.11.0

# How many CPU cores LinguaCast may use, which is how many events can run at once. One
# event runs on one core start to finish, so this buys parallelism between events and
# crash protection, never a bigger audience for a single one. Capped by the host's core
# count. Each core in use needs one RTC port, so raising this means publishing and
# forwarding the matching extra ports.
#MEDIA_MAX_WORKERS=4

# The uid/gid the server runs as, and the owner the container gives the data directory.
# Set these to your own if you want to read the database from the host.
#PUID=1000
#PGID=1000

# Helps a guest behind a restrictive NAT discover the address to advertise, and is what
# the startup check asks for a second opinion on your public address. Set it empty to use
# none — this server is a third party learning that a guest connected here.
#MEDIA_STUN_URL=stun:stun.l.google.com:19302

# How much the server says: error, warn, info, debug or trace. debug adds per-connection
# detail — ICE and DTLS progress; trace adds the network addresses of the people
# listening. Raise it only while reproducing a problem, read the output before you share
# it, and put it back afterwards — what trace writes goes to the retained log too, where
# it stays for a fortnight.
#LOG_LEVEL=info

# Where the retained copy of the log is written: one JSON object per line, a new file each
# day, the oldest deleted once 14 have accumulated. Docker discards the container's own
# output when an upgrade recreates it, which is why this copy exists. Set it empty to
# write none.
#LOG_DIR=/data/logs
