{
  "name": "@hallspeak/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./routes": "./src/routes/index.ts",
    "./socket": "./src/socket/index.ts",
    "./patterns": "./src/schemas/patterns.ts",
    "./page-titles": "./src/page-titles.ts",
    "./openapi": "./src/generated/api.d.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "gen:spec": "tsx scripts/gen.ts",
    "gen:types": "openapi-codegen openapi.json -o src/generated/api.d.ts",
    "gen": "pnpm gen:spec && pnpm gen:types",
    "dev": "tsx watch --clear-screen=false scripts/gen.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hallspeak/openapi-codegen": "workspace:*",
    "@types/node": "26.2.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
