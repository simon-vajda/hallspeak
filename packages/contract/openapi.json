{
  "openapi": "3.1.0",
  "info": {
    "title": "LinguaCast API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "VersionResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "minClientVersion": {
            "type": "string"
          },
          "serverVersion": {
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "minClientVersion",
          "serverVersion"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/version": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Server and minimum supported client versions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
