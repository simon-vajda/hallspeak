# Project-specific
# Plans, design handoffs and scratch material stay local; the compounded
# learnings under docs/solutions and the release versioning contract are shared
# knowledge and belong in git.
# The directory itself must be re-included — git never descends into an
# excluded directory, so `docs` + a negation for a child would not work.
docs/*
!docs/solutions/
!docs/versioning.md

# Agent skills are shared procedure and belong in git; the settings file beside
# them is one person's local machine.
.claude/settings.local.json

# SQLite database, WAL and shared-memory sidecars. User data, never committed —
# every fresh clone self-provisions on first boot.
data/

.context/compound-engineering/
